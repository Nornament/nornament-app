# Copy to .env for local work. In production these live in Dokploy's
# Environment tab — never bind-mount a .env file into the container.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=nornament.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://nornament.example.com

POSTGRES_DB=nornament
POSTGRES_USER=nornament
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Only while migrating; its presence adds the `legacy` database alias.
# LEGACY_DB_NAME=legacy

MEDIA_BUCKET=nornamentbucket
MEDIA_ENDPOINT_URL=https://eu2.contabostorage.com
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_ADDRESSING_STYLE=path
# false routes uploads through Django, if a browser PUT fails CORS (Phase 0)
MEDIA_DIRECT_UPLOAD=true

BACKUP_BUCKET=nornament-backups
BACKUP_AT=02:30
HEALTHCHECK_PING_URL=
