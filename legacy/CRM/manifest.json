{
  "name": "Nornament CRM",
  "short_name": "Nornament",
  "description": "Nornament Jewellery CRM — Customers, Orders, Repairs",
  "start_url": "./nornament-crm.html",
  "display": "standalone",
  "background_color": "#F7F6F3",
  "theme_color": "#B08C3C",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*"]
        }
      ]
    }
  }
}
